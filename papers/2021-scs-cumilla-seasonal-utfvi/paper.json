  "kafy_position": 1,
  "study_area": "Cumilla City Corporation (CCC)",
  "country": "Bangladesh",
  "years": [1999, 2009, 2019, 2029, 2039],
  "sensors": ["Landsat 4-5 TM", "Landsat 8 OLI/TIRS"],
  "themes": ["land use/land cover change", "seasonal land surface temperature", "urban heat island", "UTFVI", "future scenario prediction"],
  "methods": ["SVM classification", "accuracy assessment (overall, user, producer, kappa)", "single-channel LST", "normalized UHI", "UTFVI", "LST and UTFVI cross-tab by land cover", "CA-ANN land cover prediction (MOLUSCE)", "ANN regression on 500 m grid (MATLAB)", "RMSE and R validation"],
  "key_result": "Urban area grew from 20.45 km2 (1999) to 26.31 km2 (2019) and is predicted to reach 31.30 km2 by 2039, when 37.06 % of the city is predicted to be at or above 33 C in summer and 35.92 km2 to fall in the strongest UTFVI class.",
  "method_details": {
    "lulc_classes": ["Water Body", "Urban Area", "Vegetation", "Bare Land"],
    "classifier": "SVM (ENVI 5.3), radial basis function kernel, gamma 0.07, penalty parameter 120.00, pyramid level 0, classification probability threshold 0.05",
    "training_samples": "about 45 per class",
    "accuracy_points": "200 random ground points and 150 Google Earth points",
    "overall_accuracy_pct": {"1999": 86.04, "2009": 84.82, "2019": 87.23},
    "scene_filter": "cloud cover < 10 %; summer and winter scenes within at most one month spacing",
    "seasons": "summer February to June; winter October to January (as defined in the study area section)",
    "lst_landsat5": {
      "radiance": "RTM6 = V/255 * (Rmax - Rmin) + Rmin, V = band 6 DN",
      "Rmax_mW_cm2_sr": 1.896,
      "Rmin_mW_cm2_sr": 0.1534,
      "kelvin": "Tk = K1 / ln(K2 / RTM6 + 1) as printed (Eq. 4)",
      "K1_as_printed_K": 1260.56,
      "K2_as_printed": 607.66,
      "b_spectral_range_um": 1.239,
      "celsius": "T = Tk - 273",
      "note": "K1 and K2 labels appear swapped vs the usual Landsat 5 constants (K1 607.76, K2 1260.56)"
    },
    "lst_landsat8": {
      "radiance": "L = (Lmax - Lmin) / DNmax * Band + Lmin",
      "bt_celsius": "BT = K2 / ln(K1 / L + 1) - 273.15",
      "ndvi": "(B5 - B4) / (B5 + B4)",
      "pv": "((NDVI - NDVImin) / (NDVImax - NDVImin))^2",
      "emissivity": "LSE = 0.004 * PV + 0.986",
      "lst": "LST = BT / (1 + (lambda * BT / rho) * ln(LSE))",
      "rho_mK": 0.01438,
      "bands": "LST computed for band 10 and band 11, then averaged"
    },
    "uhi_formula": "UHI = (Ts - Tm) / SD",
    "utfvi_formula": "UTFVI = (Ts - Tm) / Ts",
    "utfvi_classes": {
      "None": "< 0",
      "Weak": "0 - 0.005",
      "Middle": "0.005 - 0.010",
      "Strong": "0.010 - 0.015",
      "Stronger": "0.015 - 0.020",
      "Strongest": "> 0.020"
    },
    "lst_range_breaks_c": ["< 21", "21 - < 25", "25 - < 29", "29 - < 33", ">= 33"],
    "ca_ann": {
      "software": "MOLUSCE plugin, QGIS 3.1; also validated in IDRISI Selva",
      "input_pairs": "1999 & 2009 and 2009 & 2019 land cover maps",
      "drivers": ["elevation", "slope", "distance from roads", "commercial space", "educational institutions", "water bodies"],
      "max_iterations": 500,
      "neighborhood": "3 x 3 (9 cells)",
      "validation_2019": {"kappa_location": 0.89, "kappa_no": 0.91, "kappa_location_strata": 0.87, "kappa_standard": 0.86, "pct_correctness": 89.41, "overall_kappa": 0.86}
    },
    "ann_lst_utfvi": {
      "software": "MATLAB",
      "grid": "500 m x 500 m cells; cell mean values and centroid lon/lat as inputs",
      "type": "three-layer feed-forward MLP (input i, hidden j, output k)",
      "lst_inputs": ["LST(t)", "LST(t-10 or t-20)", "LULC", "NDBI", "NDBSI", "latitude", "longitude"],
      "utfvi_inputs": ["LST", "UHI", "LULC", "NDBI", "NDBSI", "latitude", "longitude"],
      "t": 2019,
      "hidden_layers": {"LST": 6, "UTFVI": 8},
      "hidden_neurons": "1-3n per layer, n = 8 (LST) and 10 (UTFVI)",
      "activation": "logistic f(y) = 1 / (1 + e^-y)",
      "initial_learning_rate": 0.1,
      "decay_rate": 0.9,
      "compared_models": {"ANN": {"rmse": 0.53, "r": 0.87}, "AlexNet": {"rmse": 0.69, "r": 0.81}},
      "validation_lst_2019": {"summer": {"rmse": 0.53, "r": 0.87}, "winter": {"rmse": 0.624, "r": 0.83}},
      "validation_utfvi_2019": {"summer": {"rmse": 0.603, "r": 0.84}, "winter": {"rmse": 0.592, "r": 0.83}}
    }
  }
